package helloworld.loop;

public class TestContinue {
    public static void main(String[] args) {
        int sum = 0, number = 0;

        while (number < 20) {
            number++;
            if (number == 10 || number == 11)
                continue;  // skip adding 10 and 11
            sum += number;
        }

        System.out.println("The sum is " + sum);
    }
